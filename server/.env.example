# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/query-quest?retryWrites=true&w=majority

# Server port
PORT=3001

# Allowed client origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Session secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-secret

# Node environment
NODE_ENV=development

# Grove AI Gateway (OpenAI-compatible Chat Completions API)
GROVE_API_KEY=your-grove-api-key
GROVE_API_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
GROVE_MODEL=gpt-5.6-luna

# Mastra Memory uses a separate database on the same MongoDB cluster
MASTRA_MONGODB_DB_NAME=query-quest-mastra

# Number of questions to generate per question bank (integer from 1 to 20)
QUESTION_BANK_CHALLENGE_COUNT=8

# Password required to access /admin and administer question banks
ADMIN_SECRET=change-me-to-a-long-random-secret
